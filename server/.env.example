# ==========================================
# NEXORA BACKEND CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5500

# JSON Web Token Secret
JWT_SECRET=nexora_super_secret_jwt_key_2026_innovation_network

# Session Expiry (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Maximum File Upload Size (in bytes: 25MB = 26214400)
MAX_FILE_SIZE_BYTES=26214400

# Environment Mode (development or production)
NODE_ENV=development

